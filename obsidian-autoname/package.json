{
  "name": "obsidian-autoname",
  "version": "1.0.0",
  "description": "Obsidian 插件：把粘贴进笔记的附件自动改名为「<笔记名>-图<N>」并同步全库引用。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:readable": "node esbuild.config.mjs once",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "attachment",
    "rename",
    "autoname"
  ],
  "author": "SOLOMON",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
